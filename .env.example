# ── Itera Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required — OpenRouter API key for LLM access (Qwen3 via OpenRouter)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — Supermemory API key for error+fix memory across sessions
# Get yours at: https://supermemory.ai
SUPERMEMORY_API_KEY=your_supermemory_api_key_here

# Optional — protocols.io access token for live protocol fetching
# Without this, Itera falls back to the local knowledge base only.
# Get yours at: https://www.protocols.io/developers (Create Access Token)
PROTOCOLS_IO_TOKEN=your_protocols_io_token_here
